{
  "name": "fantasy-football-newsletter",
  "version": "1.0.0",
  "description": "Fantasy Football Weekly Recap Newsletter Generator",
  "private": true,
  "scripts": {
    "server": "node server/index.js",
    "client": "cd client && npx react-scripts start",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "build": "cd client && npx react-scripts build",
    "start": "NODE_ENV=production node server/index.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.52.0",
    "axios": "^1.7.0",
    "concurrently": "^8.2.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "express": "^4.18.0",
    "puppeteer-core": "^22.0.0"
  }
}
